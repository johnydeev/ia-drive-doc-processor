# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero el .env.example SÍ se versiona (plantilla sin secretos)
!.env.example
# Banco de pruebas de LLMs: boletas reales del cliente — NO versionar
pruebas de LLMs/
/data/
# Backups diarios de la base de producción (scripts/backup-db.ps1): datos reales del
# cliente — NUNCA versionar.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Logs exportados de Docker
/logs/
