# ============================================================================
# .env.example — drive-doc-processor
# Copiá este archivo a `.env` y completá los valores reales.
# NUNCA commitees el `.env` (tiene secretos). Este `.env.example` va SIN valores.
#
# Nota: la mayoría de la config de Google va por CLIENTE en la base de datos
# (panel admin). Las variables GOOGLE_* de acá son solo el FALLBACK global.
# ============================================================================

# ── Base de datos (Supabase PostgreSQL) ─────────────────────────────────────
# DATABASE_URL: conexión vía pooler (PgBouncer, puerto 6543) — uso normal.
# DIRECT_URL:   conexión directa (puerto 5432) — solo para `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Seguridad ───────────────────────────────────────────────────────────────
# SESSION_SECRET: clave para firmar el JWT de sesión (mín. 32 caracteres).
SESSION_SECRET=
# GOOGLE_CREDENTIALS_ENCRYPTION_KEY: cifra los secretos guardados en DB.
# Generala con: openssl rand -hex 32 . Si falta, usa SESSION_SECRET de fallback.
GOOGLE_CREDENTIALS_ENCRYPTION_KEY=

# ── Scheduler ───────────────────────────────────────────────────────────────
# Intervalo por defecto entre escaneos de Drive (minutos). Se puede sobrescribir
# por cliente desde el panel admin.
PROCESS_INTERVAL_MINUTES=5

# Cada cuántos minutos el WORKER loguea su latido de vida ("Cola vacía — esperando
# jobs") cuando no hay nada que procesar. Opcional (default 30). Solo afecta ese log:
# el worker sigue detectando/procesando jobs al instante (polling interno de 2s).
# WORKER_HEARTBEAT_MINUTES=30

# ── IA — proveedores de extracción ──────────────────────────────────────────
# La cadena prueba los proveedores que tengan API key, en este orden de fallback:
#   Cerebras → Groq → Gemini → OpenAI → Claude
# Cerebras y Groq tienen el free tier más generoso (sin tarjeta). Los *_MODEL son
# opcionales: si se omiten, se usa el modelo por defecto indicado al lado.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Google (FALLBACK global; normalmente la config va por cliente en la DB) ──
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# La private key va entre comillas y con los \n literales escapados.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opcional: domain-wide delegation (solo Google Workspace + super admin).
GOOGLE_IMPERSONATE_EMAIL=
GOOGLE_DRIVE_PENDING_FOLDER_ID=
GOOGLE_DRIVE_SCANNED_FOLDER_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=Datos

# ── Docker / infraestructura ────────────────────────────────────────────────
# IMAGE_TAG: tag de la imagen a correr (default: latest). Lo usa docker-compose.
IMAGE_TAG=latest
# CLOUDFLARE_TUNNEL_TOKEN: token del túnel de Cloudflare (servicio `tunnel`).
CLOUDFLARE_TUNNEL_TOKEN=
